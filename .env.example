# Copy this file to .env and fill in values
#
# Required by our app (services/s3_service.py)
S3_BUCKET_NAME=

# Optional AWS region (if not already configured in your environment)
AWS_REGION=us-west-2
# AWS_DEFAULT_REGION=

# Optional: Amazon Bedrock embeddings (used by services/document_text_service.py)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIM=1024

# Optional: for LocalStack or custom S3-compatible endpoints
# S3_ENDPOINT_URL=http://localhost:4566
S3_ENDPOINT_URL=

# OpenSearch Serverless collection (single collection with ML-connector for hybrid search)
OPENSEARCH_ENDPOINT=https://<insert-collection-id>.us-west-2.aoss.amazonaws.com
OPENSEARCH_INDEX_NAME=sagemaker-docs

# Optional: collection metadata (used by scripts/setup_opensearch.py; not used by the app at runtime)
OPENSEARCH_COLLECTION_NAME=ragbot-v2-collection
# OPENSEARCH_COLLECTION_ARN=

# Optional: additional IAM principal ARNs to include in the AOSS data access policy
# (comma-separated; used by scripts/setup_opensearch.py)
AOSS_ADDITIONAL_PRINCIPALS=

# Optional: falls back to AWS_REGION / AWS_DEFAULT_REGION
OPENSEARCH_REGION=
# Optional: override SigV4 service name. If unset, inferred from endpoint.
# - Managed domains: es
# - Serverless collections: aoss
OPENSEARCH_SERVICE_NAME=
# Optional: request timeout
OPENSEARCH_TIMEOUT_SECONDS=30

# AWS credentials (use ONE approach)
# Option A: explicit keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Option B: profile-based auth (shared credentials file)
# AWS_PROFILE=default
AWS_PROFILE=
